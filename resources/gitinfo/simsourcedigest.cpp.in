#include "simsourcedigest.h"

// Keeping the values in a .cpp rather than a header means only this one tiny
// translation unit recompiles when the digest moves. configure_file leaves the
// output byte-identical and its mtime untouched when the digest has not changed,
// so an unchanged tree causes no rebuild at all.
const unsigned int SimSourceDigestZeroHour = 0x@SIM_SOURCE_DIGEST_ZEROHOUR@u;
const unsigned int SimSourceDigestGenerals = 0x@SIM_SOURCE_DIGEST_GENERALS@u;
