## AI assistant config (user-specific)
/.claude/
/CLAUDE.md

## IntelliJ, CLion, etc.
/.idea

# IntelliJ-style CMake bits
cmake-build-*/

## Ninja
.ninja_deps
.ninja_log
build.ninja

## Python
__pycache__/
*.pyc

## Build Logs (generated during development)
/logs/
GeneralsMD/logs/
Generals/logs/

# vcpkg artifacts (generated dependencies)
/vcpkg_installed/

# External reference repositories (large, don't commit)
# references/

# Release bundles
GeneralsX-macos-*.zip
GeneralsXZH-macos-*.zip
GeneralsX-linux-*.tar.gz
GeneralsXZH-linux-*.tar.gz
# GeneralsX @build Claude 27/07/2026 iOS packages are build output, not source - the signed
# GeneralsXZH-ios.ipa carries the full game assets and runs to 2 GB.
*.ipa

# flatpak build files (exclude staging/build dirs but track scripts and manifests)
.flatpak-builder/
flatpak/staging/
flatpak/*.flatpak

#tmp and log files on root folder
logs_*.zip
*.log
# iOS shell-app build products (XcodeGen regenerates the project from ios/project.yml)
ios/build/
ios/GeneralsXZH.xcodeproj/

# Local iOS signing identity (per-machine, never shared)
# Glob, not the bare name: a hand-made copy like signing.local.env.bak was NOT covered by the
# exact match and showed up as untracked, one `git add -A` away from publishing the identity.
ios/signing.local.env*
